{
  "name": "the-trenches",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "new-wallet": "tsx scripts/new-wallet.ts",
    "wallet-address": "tsx scripts/wallet-address.ts",
    "sweep": "tsx scripts/sweep.ts",
    "dbc-config": "tsx scripts/dbc-create-config.ts",
    "launch-token": "tsx scripts/launch-token.ts",
    "dbc-fees": "tsx scripts/dbc-claim-fees.ts",
    "test": "node scripts/test-sim.mjs && node scripts/test-stats.mjs",
    "make-map": "node scripts/make-map.mjs"
  },
  "dependencies": {
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.13",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.1",
    "buffer": "^6.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "overrides": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0"
  }
}
