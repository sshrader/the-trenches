# ---- Server ----
PORT=8787
# Guests can play without a wallet. Set to 1 to require a wallet sign-in.
WALLET_REQUIRED=0
# Players in one battle, and sockets per IP address
MAX_PLAYERS=60
MAX_CONN_PER_IP=4
# Behind Railway/Cloudflare: so rate limits see the visitor's IP
TRUST_PROXY=1
HSTS=1
# Optional: country codes to block (needs a CDN that sets a country header)
BLOCKED_COUNTRIES=
# Only needed if you use wallet features or the parked coin scripts
SOLANA_RPC_URL=
SOLANA_CLUSTER=

# ---- Browser (baked in at build time; redeploy after changing) ----
# Wallet sign-in is hidden until this is 1
VITE_WALLET_LOGIN=0
VITE_CLUSTER=devnet
VITE_RPC_URL=

# ---- Parked coin scripts (run on your PC) ----
PARTNER_KEYPAIR=
DBC_FEE_CLAIMER=
DBC_INITIAL_MC=30
DBC_MIGRATION_MC=190
DBC_FEE_BPS=100
DBC_CONFIG=
COIN_NAME=
COIN_SYMBOL=
COIN_URI=

# Dev/test helper: lets players press "Add wounded bot" to get a stationary 30 HP teammate (for trying out medics).
# On by default everywhere except NODE_ENV=production; set TRAINING_BOT=1 to force it on, 0 to force it off.
TRAINING_BOT=

# Saved player stats and the leaderboard live in DATA_DIR/stats.json (only wallet-signed-in players are tracked).
# On Railway, mount a volume and set DATA_DIR=/data, or the stats are wiped on every deploy.
DATA_DIR=
# Wallet sign-in is optional and on by default. VITE_WALLET_LOGIN=0 hides it.

# Fill-in bots: BOTS=1 tops each side up with bots until it has BOT_TEAM_SIZE soldiers (people count, so 5 = 5v5). Bots only exist while a person
# is online and make way as people join. Admins can flip this while the server runs (needs ADMIN_TOKEN, 12+ characters):
#   curl -X POST -H "x-admin-token: $ADMIN_TOKEN" -H "content-type: application/json" -d '{"enabled":true,"size":5}' https://your-site/api/admin/bots
BOTS=
BOT_TEAM_SIZE=5
# How good they are: easy (default; slow to react, poor aim, no lead on moving targets), normal or hard.
BOT_LEVEL=easy
ADMIN_TOKEN=
# Map order (default city,forest): each map is a best of three, then the next one. MAP_ORDER=forest,city starts on the forest.
MAP_ORDER=

# Seconds without moving, firing or touching the mouse before a player is removed (default 60, 0 = never).
IDLE_KICK_S=
